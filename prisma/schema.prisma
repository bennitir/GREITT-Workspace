generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        Int    @id @default(autoincrement())
  name      String
  kennitala String @unique
  address   String
  phone     String
  email     String
  contact   String

  nextVoucherNumber Int       @default(1)
  receiptEntryMode  String    @default("AI")
  isActive          Boolean   @default(true)
  closedAt          DateTime?

  // VSK – stofngrunnur
  vatNumber           String?
  vatRegistered       Boolean?
  vatRegistrationDate DateTime?
  vatSettlementType   String?
  vatDataSource       String?
  vatDataUpdatedAt    DateTime?
  vatConfirmedAt      DateTime?
  vatConfirmedBy      String?

  // RSK / starfsemi
rskRegisteredActivities String?
activeActivities        String?
rskCertificatePath      String?
rskDataUpdatedAt        DateTime?
activitiesConfirmedAt   DateTime?
activitiesConfirmedBy   String?

activities CompanyActivity[]

  // Tengingar
  accounts     Account[]
  aiUsage      AiUsage[]
  auditEvents  AuditEvent[]
  modules      CompanyModule[]
  imports      ImportBatch[]
  receipts     Receipt[]
  usageEvents  UsageEvent[]
  users        UserCompany[]
  workLogs     WorkLog[]
  workOrders   WorkOrder[]
  bankAccounts BankAccount[]
  vatPeriods   VatPeriod[]

  // Innsýn – sameiginlegt gagnalag
  insightEntities       InsightEntity[]
  financialEvents       FinancialEvent[]
  insightFacts          InsightFact[]
  insightProcessingJobs InsightProcessingJob[]

  // Bókaraminni – lærð og staðfest bókunarmynstur
  accountingPatterns AccountingPattern[]
}

model Customer {
  id        Int    @id @default(autoincrement())
  name      String
  kennitala String @unique
  email     String
  phone     String
  address   String
}

model Receipt {
  id                     Int       @id @default(autoincrement())
  date                   DateTime?
  description            String
  amount                 Float
  fileName               String?
  filePath               String?
  fileHash               String?
  status                 String    @default("NEW")
  receiptNumber          String?
  voucherNumber          Int?
  merchantName           String?
  merchantKennitala      String?
  ocrText                String?
  ocrConfidence          Float?
  ocrStatus              String?
  aiDate                 DateTime?
  aiAmount               Float?
  aiApprovedAt           DateTime?
  documentCount          Int?
  suggestedDebitAccount  String?
  suggestedCreditAccount String?
  suggestedBookingText   String?
  companyId              Int
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  storagePath            String?

  aiBookingEntries    AiBookingEntry[]
  aiDetectedDocuments AiDetectedDocument[]
  company             Company              @relation(fields: [companyId], references: [id])
  entries             ReceiptEntry[]
  financialEventLinks DocumentFinancialEvent[]
  entityLinks         DocumentEntityLink[]
  insightFacts        InsightFact[]
  insightProcessingItems InsightProcessingItem[]
  accountingPatternEvidence AccountingPatternEvidence[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, voucherNumber])
}

model ReceiptEntry {
  id        Int     @id @default(autoincrement())
  account   String
  text      String
  debit     Float   @default(0)
  credit    Float   @default(0)
  receiptId Int
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model AiBookingEntry {
  id        Int     @id @default(autoincrement())
  account   String
  text      String
  debit     Float   @default(0)
  credit    Float   @default(0)
  receiptId Int
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model AiDetectedDocument {
  id                     Int       @id @default(autoincrement())
  merchantName           String?
  date                   DateTime?
  receiptNumber          String?
  totalAmount            Float?
  summary                String
  receiptId              Int
  approvedAt             DateTime?
  voucherNumber          Int?
  reviewedAt             DateTime?
  pageNumber             Int?
  duplicateMarkedAt      DateTime?
  duplicateOfDocumentId  Int?
  duplicateVoucherNumber Int?
  merchantKennitala      String?

  disposition       String?
  dispositionReason String?
  disposedAt        DateTime?
  disposedById      Int?

  // Skjalaflokkun áður en bókun er ákveðin.
  // Dæmi: INVOICE, CREDIT_NOTE, PAYMENT_NOTICE, STATEMENT, OFFER, CONTRACT, INFORMATION.
  documentType             String?
  // Hlutverk gagnvart fjárhagsatburði. Dæmi: PRIMARY, PAYMENT, SETTLEMENT, SUPPORTING, INSIGHT_ONLY.
  documentRole             String?
  classificationConfidence Float?
  classificationSource     String?
  classifiedAt             DateTime?

  receipt             Receipt                   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  bookingEntries      AiDetectedDocumentEntry[]
  financialEventLinks DocumentFinancialEvent[]
  entityLinks          DocumentEntityLink[]
  insightFacts         InsightFact[]
  insightProcessingItems InsightProcessingItem[]
  accountingPatternEvidence AccountingPatternEvidence[]

  @@index([receiptId])
  @@index([voucherNumber])
}

model AiDetectedDocumentEntry {
  id         Int                @id @default(autoincrement())
  account    String
  text       String
  debit      Float              @default(0)
  credit     Float              @default(0)
  documentId Int
  document   AiDetectedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Account {
  id        Int     @id @default(autoincrement())
  number    String
  name      String
  type      String
  isActive  Boolean @default(true)
  entryRole String  @default("GENERAL")

  // VSK-meðferð
  vatRate                 Int?
  vatAccount              String?
  vatCode                 String?
  vatTreatment            String?
  vatDeductiblePercent    Int?
  vatRequiresConfirmation Boolean @default(false)

  companyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company            Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  insightEntityLinks InsightEntityAccountLink[]
  accountingPatterns AccountingPattern[]

  @@unique([companyId, number])
  @@index([companyId, isActive])
}

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String?
  mustChangePassword Boolean  @default(false)
  role               String   @default("CLIENT")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions            Session[]
  companies           UserCompany[]
  workLogs            WorkLog[]
  createdWorkOrders   WorkOrder[]
  vatSubmissions      VatSubmission[]
  passwordResetTokens PasswordResetToken[]
  auditEvents         AuditEvent[]
  accountingPatternConfirmations AccountingPattern[] @relation("AccountingPatternLastConfirmedBy")
  accountingPatternEvidence      AccountingPatternEvidence[]
  insightProcessingJobs          InsightProcessingJob[] @relation("InsightProcessingRequestedBy")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserCompany {
  id         Int     @id @default(autoincrement())
  userId     Int
  companyId  Int
  isActive   Boolean @default(true)
  accessRole String  @default("MANAGER")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiUsage {
  id                Int      @id @default(autoincrement())
  companyId         Int?
  userId            Int?
  receiptId         Int?
  action            String
  model             String
  inputTokens       Int      @default(0)
  cachedInputTokens Int      @default(0)
  outputTokens      Int      @default(0)
  totalTokens       Int      @default(0)
  costUsd           Float    @default(0)
  costIsk           Float    @default(0)
  usdIskRate        Float    @default(0)
  durationMs        Int?
  success           Boolean  @default(true)
  errorMessage      String?
  createdAt         DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([createdAt])
}

model CompanyModule {
  id        Int      @id @default(autoincrement())
  moduleId  String
  enabled   Boolean  @default(true)
  companyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleId])
  @@index([companyId])
}

model VoucherNumberReservation {
  id            Int      @id @default(autoincrement())
  companyId     Int
  voucherNumber Int
  sourceType    String
  sourceId      Int
  createdAt     DateTime @default(now())

  @@unique([companyId, voucherNumber])
  @@index([companyId])
}

model ImportBatch {
  id            Int      @id @default(autoincrement())
  companyId     Int
  bankAccountId Int?
  fileName      String
  sourceType    String   @default("CSV")
  status        String   @default("NEW")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  rows        ImportRow[]

  @@index([companyId])
  @@index([bankAccountId])
}

model ImportRow {
  id            Int       @id @default(autoincrement())
  importBatchId Int
  rowNumber     Int
  voucherNumber Int?
  date          DateTime?
  account       String?
  text          String?
  debit         Float     @default(0)
  credit        Float     @default(0)
  status        String    @default("NEW")
  errorMessage  String?
  rawData       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([importBatchId, rowNumber])
}

model UsageEvent {
  id           Int      @id @default(autoincrement())
  companyId    Int
  eventType    String
  description  String?
  quantity     Float    @default(1)
  unitCostIsk  Float    @default(0)
  totalCostIsk Float    @default(0)
  metadata     String?
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdAt])
  @@index([eventType])
}

model WorkOrder {
  id          Int       @id @default(autoincrement())
  companyId   Int
  createdById Int?
  title       String
  description String?
  address     String?
  priority    String    @default("NORMAL")
  status      String    @default("NEW")
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  workLogs  WorkLog[]
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id])

  @@index([companyId])
  @@index([status])
  @@index([createdById])
}

model WorkLog {
  id              Int       @id @default(autoincrement())
  companyId       Int
  workOrderId     Int
  userId          Int?
  workDate        DateTime
  startedAt       DateTime?
  endedAt         DateTime?
  breakMinutes    Int       @default(0)
  durationMinutes Int?
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([workOrderId])
  @@index([userId])
  @@index([workDate])
}

model BankAccount {
  id            Int      @id @default(autoincrement())
  companyId     Int
  name          String
  bankName      String
  accountNumber String?
  iban          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions  BankTransaction[]
  importBatches ImportBatch[]

  @@index([companyId])
}

model BankTransaction {
  id            Int      @id @default(autoincrement())
  bankAccountId Int
  date          DateTime
  text          String
  amount        Decimal
  reference     String?
  fingerprint   String?
  status        String   @default("UNRECONCILED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([bankAccountId, fingerprint])
  @@index([bankAccountId, date])
  @@index([bankAccountId, status])
}

model VatPeriod {
  id        Int @id @default(autoincrement())
  companyId Int
  year      Int
  period    Int

  // Tímabil
  periodType  String?
  periodStart DateTime?
  periodEnd   DateTime?

  // Staða tímabils
  status  String    @default("OPEN")
  dueDate DateTime?

  // Uppruni / staðfesting
  dataSource  String?
  confirmedAt DateTime?
  confirmedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submissions VatSubmission[]

  @@unique([companyId, year, period])
  @@index([companyId, year, period])
  @@index([companyId, status])
  @@index([companyId, dueDate])
}

model VatSubmission {
  id             Int    @id @default(autoincrement())
  vatPeriodId    Int
  version        Int    @default(1)
  submissionType String @default("ORIGINAL")
  status         String @default("DRAFT")

  // VSK-skýrsla A–H
  a Float @default(0)
  b Float @default(0)
  c Float @default(0)
  d Float @default(0)
  e Float @default(0)
  f Float @default(0)
  g Float @default(0)
  h Float @default(0)

  // Útreikningur / leiðrétting
  calculationSource String?
  calculatedAt      DateTime?
  correctionReason  String?

  // Skil og rekjanleiki
  createdById    Int?
  submittedAt    DateTime?
  rskReference   String?
  rskReceiptPath String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vatPeriod VatPeriod @relation(fields: [vatPeriodId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([vatPeriodId, version])
  @@index([vatPeriodId])
  @@index([vatPeriodId, status])
  @@index([submittedAt])
}

// ============================================================
// INNSÝN – SAMEIGINLEGT GAGNALAG
//
// Markmið:
// - Skjal er ekki það sama og fjárhagsatburður.
// - Fleiri en eitt skjal geta lýst sama atburði.
// - Sama eign/ađili/lán/samningur getur komið fyrir í mörgum skjölum.
// - Staðreyndir sem eru óþarfar fyrir bókun mega samt varðveitast fyrir Innsýn.
// ============================================================

model InsightEntity {
  id        Int      @id @default(autoincrement())
  companyId Int

  // Almennt entity-líkan: VEHICLE, PROPERTY, PERSON, ORGANIZATION, LOAN, CONTRACT, METER o.fl.
  entityType String
  name       String
  status     String   @default("ACTIVE")

  // Sterkt auðkenni þegar það er til, t.d. skráningarnúmer, fasteignanúmer eða lánsnúmer.
  identifierType  String?
  identifierValue String?

  // Tengsl við fyrirtækið/notandann eru staðfest sérstaklega; AI á ekki að gera ráð fyrir þeim.
  relationshipStatus String?
  relationshipType   String?
  relationshipNote   String?
  relationshipConfirmedAt DateTime?
  relationshipConfirmedBy Int?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentLinks DocumentEntityLink[]
  eventLinks    FinancialEventEntity[]
  facts         InsightFact[]
  accountLinks  InsightEntityAccountLink[]

  @@index([companyId, entityType])
  @@index([companyId, identifierType, identifierValue])
  @@index([companyId, status])
}


model InsightEntityAccountLink {
  id        Int @id @default(autoincrement())
  entityId  Int
  accountId Int

  // Hlutverk reiknings gagnvart entity.
  // Dæmi: LIABILITY_PRINCIPAL, ASSET, EXPENSE, REVENUE, BANK.
  role String

  // PROPOSED = tillaga sem má koma frá AI/SYSTEM.
  // CONFIRMED = notandi/bókari hefur staðfest tenginguna.
  // REJECTED = tillögu hefur verið hafnað.
  status String @default("PROPOSED")

  source     String @default("SYSTEM")
  confidence Float?
  note       String?

  confirmedAt DateTime?
  confirmedBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity  InsightEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([entityId, accountId, role])
  @@index([entityId, status])
  @@index([accountId, status])
  @@index([role, status])
}

model FinancialEvent {
  id        Int      @id @default(autoincrement())
  companyId Int

  // Dæmi: CHARGE, CREDIT, PAYMENT, SETTLEMENT, LOAN_INSTALLMENT, ANNUAL_ASSESSMENT.
  eventType String
  status    String   @default("OPEN")
  title     String?
  eventDate DateTime?

  // Atburðardagsetning, þjónustutímabil og leiðréttingartímabil geta verið ólík.
  periodStart DateTime?
  periodEnd   DateTime?

  amount   Decimal?
  currency String   @default("ISK")

  externalReference String?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company       Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentLinks DocumentFinancialEvent[]
  entityLinks   FinancialEventEntity[]
  facts         InsightFact[]

  @@index([companyId, eventType])
  @@index([companyId, eventDate])
  @@index([companyId, status])
  @@index([companyId, externalReference])
}

model DocumentFinancialEvent {
  id          Int @id @default(autoincrement())
  receiptId   Int
  documentId  Int?
  eventId     Int

  // PRIMARY, PAYMENT, SETTLEMENT, SUPPORTING, CORRECTION o.fl.
  role       String
  confidence Float?
  source     String @default("SYSTEM")
  createdAt  DateTime @default(now())

  receipt  Receipt             @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  document AiDetectedDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  event    FinancialEvent      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([documentId, eventId])
  @@index([receiptId])
  @@index([eventId])
}

model DocumentEntityLink {
  id         Int @id @default(autoincrement())
  receiptId  Int
  documentId Int?
  entityId   Int

  // Dæmi: SUBJECT, ASSET, BORROWER, LENDER, POLICY_HOLDER, BENEFICIARY, PAYER.
  role       String
  confidence Float?
  source     String @default("SYSTEM")
  confirmedAt DateTime?
  confirmedBy Int?
  createdAt  DateTime @default(now())

  receipt  Receipt             @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  document AiDetectedDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entity   InsightEntity       @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([documentId, entityId, role])
  @@index([receiptId])
  @@index([entityId])
}

model FinancialEventEntity {
  id       Int @id @default(autoincrement())
  eventId  Int
  entityId Int
  role     String
  createdAt DateTime @default(now())

  event  FinancialEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entity InsightEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([eventId, entityId, role])
  @@index([entityId])
}

model InsightFact {
  id        Int @id @default(autoincrement())
  companyId Int
  receiptId Int?
  documentId Int?
  entityId  Int?
  eventId   Int?

  // Sveigjanlegar staðreyndir, t.d. DISTANCE_KM, UNIT_PRICE, USAGE_KWH, PREMIUM, DEDUCTIBLE.
  factType String
  label    String?

  numberValue Decimal?
  textValue   String?
  dateValue   DateTime?
  booleanValue Boolean?
  unit         String?
  currency     String?

  periodStart DateTime?
  periodEnd   DateTime?
  confidence  Float?
  source      String @default("AI")
  metadata    Json?
  createdAt   DateTime @default(now())

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  receipt  Receipt?            @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  document AiDetectedDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entity   InsightEntity?      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  event    FinancialEvent?     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([companyId, factType])
  @@index([receiptId])
  @@index([documentId])
  @@index([entityId, factType])
  @@index([eventId, factType])
}

// ============================================================
// INNSÝN – VINNSLULAG / BAKGRUNNSVINNSLA
//
// Markmið:
// - AI-vinnsla má ekki stjórna bókunar- eða afgreiðslustöðu skjals.
// - Vinnsla er server-bundin og má halda áfram þótt notandi fari af síðunni.
// - Sama skjal má lesa aftur með nýrri vinnsluútgáfu.
// - Batch/job heldur utan um heildarframvindu; hvert skjal er sjálfstætt.
// - Villa í einu skjali má ekki stöðva önnur skjöl.
// ============================================================

model InsightProcessingJob {
  id        Int @id @default(autoincrement())
  companyId Int

  // Dæmi: SINGLE_DOCUMENT, HISTORICAL_REREAD, UPLOAD_BATCH.
  jobType String

  // PENDING, PROCESSING, COMPLETED, COMPLETED_WITH_ERRORS, FAILED, CANCELLED.
  status String @default("PENDING")

  // Útgáfa vinnsluflæðisins sem á að keyra, t.d. "insight-v1".
  processingVersion String

  // Hver/hvað stofnaði vinnsluna: USER, SYSTEM, UPLOAD o.fl.
  source String @default("SYSTEM")

  requestedById Int?

  totalItems     Int @default(0)
  pendingItems   Int @default(0)
  processingItems Int @default(0)
  completedItems Int @default(0)
  failedItems    Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  errorMessage String?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedBy User?   @relation("InsightProcessingRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  items       InsightProcessingItem[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
}

model InsightProcessingItem {
  id    Int @id @default(autoincrement())
  jobId Int

  receiptId  Int
  documentId Int?

  // Stöðugur lykill innan jobs, t.d. DOCUMENT:123 eða RECEIPT:456.
  // Þetta tryggir idempotency líka þegar documentId er null.
  itemKey String

  // PENDING, PROCESSING, COMPLETED, FAILED, NEEDS_REPROCESS.
  status String @default("PENDING")

  // Útgáfan sem þessi tiltekna vinnsla notar.
  processingVersion String

  // Fjöldi tilrauna styður örugga endurkeyrslu síðar.
  attemptCount Int @default(0)

  startedAt     DateTime?
  completedAt   DateTime?
  lastAttemptAt DateTime?
  errorMessage  String?

  // Samantekt um niðurstöðu vinnslunnar; staðreyndir/entities/events
  // sjálf eru áfram geymd í sínum sérhæfðu Innsýn-líkönum.
  resultMetadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job      InsightProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  receipt  Receipt              @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  document AiDetectedDocument?  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([jobId, itemKey])
  @@index([jobId, status])
  @@index([receiptId, status])
  @@index([documentId, status])
  @@index([receiptId, documentId, processingVersion])
}

// Sameiginlegur rekjanleiki GLÖGGT.
//
// Markmiðið er að varðveita atburðasögu án þess að þurfa
// sérstakt audit-model fyrir Fylgiskjöl, VSK, Banka, Verk o.s.frv.
//
// entityType + entityId segja hvaða hlut atburðurinn varðar.
// Dæmi:
// RECEIPT / 42
// VAT_SUBMISSION / 8
// BANK_TRANSACTION / 120
//
// parentEntityType + parentEntityId má nota til að tengja atburð
// við stærra samhengi, t.d. bókunarlínu við fylgiskjal.
model AuditEvent {
  id        Int  @id @default(autoincrement())
  companyId Int
  userId    Int?

  entityType String
  entityId   Int
  action     String

  parentEntityType String?
  parentEntityId   Int?

  source      String  @default("SYSTEM")
  description String?

  // JSON texti varðveitir stöðu fyrir/eftir þegar þess þarf.
  // Við geymum ekki slíkt nema atburðurinn krefjist þess.
  beforeData Json?
afterData  Json?
metadata   Json?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([entityType, entityId])
  @@index([parentEntityType, parentEntityId])
  @@index([userId])
  @@index([action])
}

model CompanyActivity {
  id        Int @id @default(autoincrement())
  companyId Int

  // Starfsemugrein
  code String?
  name String

  // Staða starfseminnar
  registeredAtRsk Boolean @default(false)
  isActive        Boolean @default(true)

  // Uppruni upplýsinganna
  dataSource String?
  dataUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, isActive])
  @@index([companyId, registeredAtRsk])
}

// ============================================================
// BÓKARAMINNI GLÖGGT
// ============================================================
//
// GLÖGGT lærir eingöngu af staðfestum ákvörðunum bókara/notanda.
// AI-tillaga ein og sér má aldrei styrkja mynstur.
//
// Mynstur er fyrirtækjabundið. Bókarinn sem kennir mynstrið er
// varðveittur í rekjanleika, en mynstur eins fyrirtækis mengar
// ekki önnur fyrirtæki.
//
// automationLevel:
// SUGGEST_ONLY = aðeins tillaga.
// AUTO_IF_SAFE = má síðar nota sjálfkrafa þegar öryggisskilyrði leyfa.
model AccountingPattern {
  id        Int @id @default(autoincrement())
  companyId Int

  // Fyrsta útgáfa notar ACCOUNT_SELECTION.
  patternType String

  // Dæmi: SETTLEMENT_ACCOUNT, EXPENSE_ACCOUNT, INTEREST_ACCOUNT, FEE_ACCOUNT.
  decisionRole String

  // Stöðugur lykill sem þjónustulag GLÖGGT býr til úr þeim
  // einkennum sem skilgreina sambærileg skjöl.
  matchKey String

  // Sveigjanleg gögn sem útskýra af hverju mynstrið passar.
  matchData Json?

  // Niðurstaða reikningsvals.
  targetAccountId Int?

  // Fyrir önnur lærð gildi síðar, t.d. texta eða VSK-meðferð.
  valueData Json?

  status          String @default("ACTIVE")
  automationLevel String @default("SUGGEST_ONLY")

  // Traust byggist aðeins á staðfestum ákvörðunum bókara.
  confidence Float @default(0)

  confirmationCount Int @default(0)
  correctionCount   Int @default(0)

  lastConfirmedAt   DateTime?
  lastConfirmedById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  targetAccount   Account? @relation(fields: [targetAccountId], references: [id], onDelete: SetNull)
  lastConfirmedBy User?    @relation("AccountingPatternLastConfirmedBy", fields: [lastConfirmedById], references: [id], onDelete: SetNull)

  evidence AccountingPatternEvidence[]

  @@unique([companyId, patternType, decisionRole, matchKey])
  @@index([companyId, status])
  @@index([companyId, patternType, decisionRole])
  @@index([companyId, matchKey])
  @@index([targetAccountId])
  @@index([lastConfirmedById])
}

// Einstök kennsluatvik fyrir bókaraminnið.
// AuditEvent er áfram almenni rekjanleikinn; þetta líkan geymir
// sérstaklega sönnunargögn þess sem GLÖGGT hefur lært.
model AccountingPatternEvidence {
  id         Int @id @default(autoincrement())
  patternId  Int
  receiptId  Int?
  documentId Int?
  userId     Int?

  // CONFIRMED, CORRECTED, REJECTED.
  action String

  // AI-tillaga eða fyrri niðurstaða.
  beforeData Json?

  // Staðfest niðurstaða bókarans.
  afterData Json?

  createdAt DateTime @default(now())

  pattern  AccountingPattern   @relation(fields: [patternId], references: [id], onDelete: Cascade)
  receipt  Receipt?            @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  document AiDetectedDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  user     User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([patternId, createdAt])
  @@index([receiptId])
  @@index([documentId])
  @@index([userId])
}

