  // Röð verkþátta innan sama Verks. Hún segir framsetningarröð,
  // en er ekki dependency-grafið sjálft.
  sequence Int @default(1)

  // Frumtexti er varðveittur óbreyttur. Þýðingar eru geymdar
  // sjálfstætt í WorkPartTranslation og yfirskrifa aldrei frumtextann.
  sourceLanguage String @default("is")
  title          String
  description    String?

  status String @default("PLANNED")

  createdById Int?
  updatedById Int?
