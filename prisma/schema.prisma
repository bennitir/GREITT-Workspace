  createdBy    User?                 @relation("WorkPartCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?                 @relation("WorkPartUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  translations WorkPartTranslation[]
  assignments  WorkPartAssignment[]
  laborFacts   WorkPartLaborFact[]
  usageFacts   WorkPartUsageFact[]
  inventoryMovements InventoryMovement[]

  @@unique([workOrderId, sequence])
  @@index([companyId])
  @@index([workOrderId])
  @@index([status])
}

