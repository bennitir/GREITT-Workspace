generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        Int    @id @default(autoincrement())
  name      String
  kennitala String @unique
  address   String
  phone     String
  email     String
  contact   String

  nextVoucherNumber Int       @default(1)
  receiptEntryMode  String    @default("AI")
  isActive          Boolean   @default(true)
  closedAt          DateTime?

  // VSK – stofngrunnur
  vatNumber           String?
  vatRegistered       Boolean?
  vatRegistrationDate DateTime?
  vatSettlementType   String?
  vatDataSource       String?
  vatDataUpdatedAt    DateTime?
  vatConfirmedAt      DateTime?
  vatConfirmedBy      String?

  // Launagreiðendaskrá / staðgreiðsla og tryggingagjald
  payrollRegistered       Boolean?
  payrollRegistrationDate DateTime?
  payrollDataSource       String?
  payrollDataUpdatedAt    DateTime?
  payrollConfirmedAt      DateTime?
  payrollConfirmedBy      String?

  // RSK / starfsemi
  rskRegisteredActivities String?
  activeActivities        String?
  rskCertificatePath      String?
  rskDataUpdatedAt        DateTime?
  activitiesConfirmedAt   DateTime?
  activitiesConfirmedBy   String?

  activities CompanyActivity[]
  messages   CompanyMessage[]

  // Tengingar
  accounts     Account[]
  aiUsage      AiUsage[]
  auditEvents  AuditEvent[]
  modules      CompanyModule[]
  imports      ImportBatch[]
  receipts     Receipt[]
  usageEvents  UsageEvent[]
  users        UserCompany[]
  employees    Employee[]
  employeeCompensations EmployeeCompensation[]
  employeeQualifications EmployeeQualification[]
  workLogs     WorkLog[]
  workOrders   WorkOrder[]
  workParts    WorkPart[]
  workPartAssignments WorkPartAssignment[]
  workPartLaborFacts WorkPartLaborFact[]
  workPartUsageFacts WorkPartUsageFact[]
  inventoryItems InventoryItem[]
  inventoryLocations InventoryLocation[]
  inventoryMovements InventoryMovement[]
  inventoryStocktakes InventoryStocktake[]
  inventoryTransfers InventoryTransfer[]
  inventoryCommitments InventoryCommitment[]
  inventoryCountSessions InventoryCountSession[]
  inventoryCountLines InventoryCountLine[]
  bankAccounts BankAccount[]
  vatPeriods   VatPeriod[]

  // Innsýn – sameiginlegt gagnalag
  insightEntities       InsightEntity[]
  financialEvents       FinancialEvent[]
  insightFacts          InsightFact[]
  insightProcessingJobs InsightProcessingJob[]

  // Bókaraminni – lærð og staðfest bókunarmynstur
  accountingPatterns AccountingPattern[]

  // Ábendingar frá notendum/bókurum til þróunar GLÖGGT.
  suggestions Suggestion[]
  bookkeepingSettings CompanyBookkeepingSettings?
  serviceTimeEntries ServiceTimeEntry[]
  tasks CompanyTask[]
}


model CompanyBookkeepingSettings {
  companyId Int @id

  // Hvernig gögn eru almennt undirbúin. Þetta stýrir ekki sjálft bókunarheimild.
  preparationMode String @default("HYBRID")

  // Óháð stjórnskref sem geta þurft að klárast áður en bókun er heimil.
  requireReviewBeforeBooking         Boolean @default(false)
  requireReconciliationBeforeBooking Boolean @default(false)
  requireApprovalBeforeBooking       Boolean @default(false)

  // Þegar öll virk stjórnskref eru uppfyllt:
  // MANUAL_CONFIRMATION = bíður eftir Bóka; AUTO_BOOK = bókar sjálfkrafa.
  completionMode String @default("MANUAL_CONFIRMATION")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}


// Almenn verkefni, frestir og áminningar fyrir Heimasvæði GLÖGGT.
// Verkefnið getur verið handvirkt eða orðið til úr annarri einingu síðar.
model CompanyTask {
  id Int @id @default(autoincrement())
  companyId Int

  taskType String @default("GENERAL")
  title String
  details String?
  status String @default("OPEN") // OPEN | COMPLETED | CANCELLED
  priority String @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  dueAt DateTime?

  // Ef assigneeUserId er null er verkefnið fyrirtækisverkefni.
  assigneeUserId Int?
  createdByUserId Int?
  completedByUserId Int?
  completedAt DateTime?

  // Gagnaskil sem tengjast verkefninu. Þetta er almennt lag sem nýtist
  // t.d. VSK, launum og ársuppgjöri. Opinber skilafrestur er áfram dueAt.
  dataRequestStatus String @default("NONE") // NONE | REQUESTED | CLIENT_SUBMITTED | ACCEPTED | NEEDS_MORE
  dataDueAt DateTime?
  reminderStartAt DateTime?
  reminderIntervalDays Int @default(3)
  lastReminderAt DateTime?
  clientSubmittedAt DateTime?
  clientSubmittedByUserId Int?
  dataReviewedAt DateTime?
  dataReviewedByUserId Int?

  // Rekjanleg tenging við uppruna verkefnis þegar það verður til sjálfvirkt.
  sourceType String?
  sourceId String?

  // Innri aðgerð í GLÖGGT og/eða opinber ytri skilaleið.
  actionPath String?
  externalUrl String?

  // Endurtekning. Næsta verkefni verður til þegar þessu er lokið.
  recurrenceFrequency String @default("NONE") // NONE | DAILY | WEEKLY | MONTHLY | YEARLY
  recurrenceInterval Int @default(1)

  // Kerfisregla fyrir lögbundin skil. Slík skil reikna frest út frá uppgjörstímabili.
  scheduleRule String @default("NONE") // NONE | VAT_GENERAL_BIMONTHLY
  periodStart DateTime?
  periodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignee User? @relation("CompanyTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  createdBy User? @relation("CompanyTaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  completedBy User? @relation("CompanyTaskCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  clientSubmittedBy User? @relation("CompanyTaskClientSubmittedBy", fields: [clientSubmittedByUserId], references: [id], onDelete: SetNull)
  dataReviewedBy User? @relation("CompanyTaskDataReviewedBy", fields: [dataReviewedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status, dueAt])
  @@index([assigneeUserId, status, dueAt])
  @@index([sourceType, sourceId])
  @@index([companyId, dataRequestStatus, dataDueAt])
}


// Almenn skilaboð innan fyrirtækis. Skilaboð eru aðskilin frá verkefnum/frestum.
// Sendingarleiðir (t.d. tölvupóstur/push) geta síðar byggt ofan á sama grunn.
model CompanyMessage {
  id Int @id @default(autoincrement())
  companyId Int
  recipientUserId Int
  createdByUserId Int

  subject String
  body String
  readAt     DateTime?
  archivedAt DateTime?
  trashedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recipient User @relation("CompanyMessageRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  createdBy User @relation("CompanyMessageCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([companyId, recipientUserId, readAt, createdAt])
  @@index([companyId, recipientUserId, archivedAt, trashedAt])
  @@index([companyId, createdByUserId, createdAt])
}

model Customer {
  id        Int    @id @default(autoincrement())
  name      String
  kennitala String @unique
  email     String
  phone     String
  address   String
}

model Receipt {
  id                     Int       @id @default(autoincrement())
  date                   DateTime?
  description            String
  amount                 Float
  fileName               String?
  filePath               String?
  fileHash               String?
  status                 String    @default("NEW")
  receiptNumber          String?
  voucherNumber          Int?
  merchantName           String?
  merchantKennitala      String?
  ocrText                String?
  ocrConfidence          Float?
  ocrStatus              String?
  aiDate                 DateTime?
  aiAmount               Float?
  aiApprovedAt           DateTime?
  documentCount          Int?
  suggestedDebitAccount  String?
  suggestedCreditAccount String?
  suggestedBookingText   String?
  companyId              Int
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  storagePath            String?

  aiBookingEntries          AiBookingEntry[]
  aiDetectedDocuments       AiDetectedDocument[]
  company                   Company                     @relation(fields: [companyId], references: [id])
  entries                   ReceiptEntry[]
  financialEventLinks       DocumentFinancialEvent[]
  entityLinks               DocumentEntityLink[]
  insightFacts              InsightFact[]
  insightProcessingItems    InsightProcessingItem[]
  accountingPatternEvidence AccountingPatternEvidence[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, voucherNumber])
}

model ReceiptEntry {
  id        Int     @id @default(autoincrement())
  account   String
  text      String
  debit     Float   @default(0)
  credit    Float   @default(0)
  receiptId Int
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model AiBookingEntry {
  id        Int     @id @default(autoincrement())
  account   String
  text      String
  debit     Float   @default(0)
  credit    Float   @default(0)
  receiptId Int
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model AiDetectedDocument {
  id                     Int       @id @default(autoincrement())
  merchantName           String?
  date                   DateTime?
  receiptNumber          String?
  totalAmount            Float?
  summary                String
  receiptId              Int
  approvedAt             DateTime?
  voucherNumber          Int?
  reviewedAt             DateTime?
  pageNumber             Int?
  duplicateMarkedAt      DateTime?
  duplicateOfDocumentId  Int?
  duplicateVoucherNumber Int?
  merchantKennitala      String?

  // Skipulögð framtíðargreiðsla sem AI les af frumskjalinu.
  // Þetta er uppbyggð heimild fyrir FinancialEvent; ekki bókunarlínur.
  paymentSchedule         Json?

  disposition       String?
  dispositionReason String?
  disposedAt        DateTime?
  disposedById      Int?

  // Staðfesting á að skjal tilheyri þessu fyrirtækjaumhverfi þrátt fyrir
  // viðvörun, t.d. þegar nafn/kennitala á frumskjali er önnur.
  // Þetta er samhengi skjalsins en EKKI staðfesting á bókunarreikningum.
  environmentReviewRequired     Boolean  @default(false)
  environmentReviewReason       String?
  environmentConfirmedAt        DateTime?
  environmentConfirmedById      Int?
  environmentConfirmationReason String?

  // Skjalaflokkun áður en bókun er ákveðin.
  // Dæmi: INVOICE, CREDIT_NOTE, PAYMENT_NOTICE, STATEMENT, OFFER, CONTRACT, INFORMATION.
  documentType             String?
  // Hlutverk gagnvart fjárhagsatburði. Dæmi: PRIMARY, PAYMENT, SETTLEMENT, SUPPORTING, INSIGHT_ONLY.
  documentRole             String?
  classificationConfidence Float?
  classificationSource     String?
  classifiedAt             DateTime?

  receipt                   Receipt                     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  bookingEntries            AiDetectedDocumentEntry[]
  financialEventLinks       DocumentFinancialEvent[]
  entityLinks               DocumentEntityLink[]
  insightFacts              InsightFact[]
  insightProcessingItems    InsightProcessingItem[]
  accountingPatternEvidence AccountingPatternEvidence[]

  @@index([receiptId])
  @@index([voucherNumber])
}

model AiDetectedDocumentEntry {
  id         Int                @id @default(autoincrement())
  account    String
  text       String
  debit      Float              @default(0)
  credit     Float              @default(0)
  documentId Int
  document   AiDetectedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Account {
  id        Int     @id @default(autoincrement())
  number    String
  name      String
  type      String
  isActive  Boolean @default(true)
  entryRole String  @default("GENERAL")

  // VSK-meðferð
  vatRate                 Int?
  vatAccount              String?
  vatCode                 String?
  vatTreatment            String?
  vatDeductiblePercent    Int?
  vatRequiresConfirmation Boolean @default(false)

  companyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company            Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  insightEntityLinks InsightEntityAccountLink[]
  accountingPatterns AccountingPattern[]
  financialLiabilityEvents FinancialEvent[] @relation("FinancialEventLiabilityAccount")

  @@unique([companyId, number])
  @@index([companyId, isActive])
}

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String?
  mustChangePassword Boolean  @default(false)
  role               String   @default("CLIENT")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions                       Session[]
  companies                      UserCompany[]
  workLogs                       WorkLog[]
  createdWorkOrders              WorkOrder[]
  createdWorkOrderTranslations   WorkOrderTranslation[] @relation("WorkOrderTranslationCreatedBy")
  createdWorkParts               WorkPart[] @relation("WorkPartCreatedBy")
  updatedWorkParts               WorkPart[] @relation("WorkPartUpdatedBy")
  createdWorkPartTranslations    WorkPartTranslation[] @relation("WorkPartTranslationCreatedBy")
  workPartAssignments            WorkPartAssignment[] @relation("WorkPartAssignmentUser")
  createdWorkPartAssignments     WorkPartAssignment[] @relation("WorkPartAssignmentCreatedBy")
  removedWorkPartAssignments     WorkPartAssignment[] @relation("WorkPartAssignmentRemovedBy")
  performedWorkPartLaborFacts     WorkPartLaborFact[] @relation("WorkPartLaborFactUser")
  createdWorkPartLaborFacts       WorkPartLaborFact[] @relation("WorkPartLaborFactCreatedBy")
  voidedWorkPartLaborFacts        WorkPartLaborFact[] @relation("WorkPartLaborFactVoidedBy")
  createdWorkPartLaborFactTranslations WorkPartLaborFactTranslation[] @relation("WorkPartLaborFactTranslationCreatedBy")
  createdWorkPartUsageFacts       WorkPartUsageFact[] @relation("WorkPartUsageFactCreatedBy")
  voidedWorkPartUsageFacts        WorkPartUsageFact[] @relation("WorkPartUsageFactVoidedBy")
  createdInventoryItems           InventoryItem[] @relation("InventoryItemCreatedBy")
  createdInventoryLocations       InventoryLocation[] @relation("InventoryLocationCreatedBy")
  createdInventoryMovements       InventoryMovement[] @relation("InventoryMovementCreatedBy")
  voidedInventoryMovements        InventoryMovement[] @relation("InventoryMovementVoidedBy")
  createdInventoryStocktakes       InventoryStocktake[] @relation("InventoryStocktakeCreatedBy")
  createdInventoryTransfers         InventoryTransfer[] @relation("InventoryTransferCreatedBy")
  createdInventoryCommitments       InventoryCommitment[] @relation("InventoryCommitmentCreatedBy")
  releasedInventoryCommitments      InventoryCommitment[] @relation("InventoryCommitmentReleasedBy")
  createdInventoryCountSessions      InventoryCountSession[] @relation("InventoryCountSessionCreatedBy")
  reviewedInventoryCountSessions     InventoryCountSession[] @relation("InventoryCountSessionReviewedBy")
  countedInventoryCountLines         InventoryCountLine[] @relation("InventoryCountLineCountedBy")
  voidedInventoryCountLines          InventoryCountLine[] @relation("InventoryCountLineVoidedBy")
  vatSubmissions                 VatSubmission[]
  passwordResetTokens            PasswordResetToken[]
  auditEvents                    AuditEvent[]
  accountingPatternConfirmations AccountingPattern[]         @relation("AccountingPatternLastConfirmedBy")
  accountingPatternEvidence      AccountingPatternEvidence[]
  insightProcessingJobs          InsightProcessingJob[]      @relation("InsightProcessingRequestedBy")

  submittedSuggestions Suggestion[] @relation("SuggestionSubmittedBy")
  reviewedSuggestions  Suggestion[] @relation("SuggestionReviewedBy")
  settings UserSettings?
  serviceTimeEntries ServiceTimeEntry[]
  assignedCompanyTasks CompanyTask[] @relation("CompanyTaskAssignee")
  createdCompanyTasks CompanyTask[] @relation("CompanyTaskCreatedBy")
  completedCompanyTasks CompanyTask[] @relation("CompanyTaskCompletedBy")
  clientSubmittedCompanyTasks CompanyTask[] @relation("CompanyTaskClientSubmittedBy")
  dataReviewedCompanyTasks CompanyTask[] @relation("CompanyTaskDataReviewedBy")
  receivedCompanyMessages CompanyMessage[] @relation("CompanyMessageRecipient")
  createdCompanyMessages CompanyMessage[] @relation("CompanyMessageCreatedBy")
  employeeProfiles Employee[] @relation("EmployeeUser")
  createdEmployees Employee[] @relation("EmployeeCreatedBy")
  updatedEmployees Employee[] @relation("EmployeeUpdatedBy")
  createdEmployeeCompensations EmployeeCompensation[] @relation("EmployeeCompensationCreatedBy")
  createdEmployeeQualifications EmployeeQualification[] @relation("EmployeeQualificationCreatedBy")
}


model UserSettings {
  userId Int @id

  // Persónulegar óskir. Þær mega aldrei veikja fyrirtækisreglur eða heimildir.
  interfaceLanguage String @default("is")
  aiExplanationLanguage String @default("is")
  aiSupportLevel String @default("STANDARD")
  aiExplanationDetail String @default("NORMAL")
  autoOpenNextDocument Boolean @default(true)
  showHelpText Boolean @default(true)

  // Þjónustutími: OFF | MANUAL | AUTO | AUTO_PROMPT
  timeTrackingMode String @default("OFF")
  timeTrackingIdleMinutes Int @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model ServiceTimeEntry {
  id Int @id @default(autoincrement())
  companyId Int
  userId Int
  source String @default("MANUAL") // MANUAL | AUTO
  category String @default("ANNAÐ")
  description String?
  module String?
  startedAt DateTime
  endedAt DateTime
  durationMinutes Int
  durationSeconds Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, startedAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserCompany {
  id         Int     @id @default(autoincrement())
  userId     Int
  companyId  Int
  isActive   Boolean @default(true)
  accessRole String  @default("MANAGER")

  // Aðgerðarheimildir innan fyrirtækis. Hlutverk gefur sjálfgefinn grunn,
  // en þessar heimildir gera okkur kleift að stýra verkum óháð hlutverksheiti.
  canPrepareBookkeeping Boolean @default(true)
  canReviewBookkeeping Boolean @default(false)
  canReconcileBookkeeping Boolean @default(false)
  canApproveExpenses Boolean @default(false)
  canBookEntries Boolean @default(false)
  canManageCompanySettings Boolean @default(false)

  // Tölvupósttilkynningar eru stilltar á tengingu notanda og fyrirtækis.
  // Sama manneskja getur því fengið tilkynningar fyrir eitt fyrirtæki en ekki annað.
  emailNotificationsEnabled Boolean @default(false)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}


model Employee {
  id        Int @id @default(autoincrement())
  companyId Int
  userId    Int?

  employeeNumber String?
  fullName       String
  kennitala      String?
  address        String?
  postalCode     String?
  city           String?
  phone          String?
  email          String?
  preferredLanguage String @default("is")

  jobTitle          String?
  department        String?
  employmentKind    String @default("EMPLOYEE") // EMPLOYEE | TEMPORARY | APPRENTICE | OTHER
  employmentStartDate DateTime?
  employmentEndDate   DateTime?
  employmentPercent Float?
  isActive          Boolean @default(true)
  notes             String?

  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user User? @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy User? @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("EmployeeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  compensations EmployeeCompensation[]
  qualifications EmployeeQualification[]
  workPartAssignments WorkPartAssignment[]
  workPartLaborFacts WorkPartLaborFact[]

  @@index([companyId, userId])
  @@index([companyId, employeeNumber])
  @@index([companyId, isActive])
  @@index([companyId, fullName])
  @@index([kennitala])
}

model EmployeeCompensation {
  id        Int @id @default(autoincrement())
  companyId Int
  employeeId Int

  validFrom DateTime
  validTo   DateTime?
  payType   String @default("MONTHLY") // MONTHLY | HOURLY | MIXED
  monthlySalary Float?
  hourlyRate    Float?
  internalCostPerMinute Float?
  internalCostSource String @default("MANUAL") // MANUAL | CALCULATED
  currency String @default("ISK")
  notes    String?

  createdById Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy User? @relation("EmployeeCompensationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, employeeId, validFrom])
  @@index([employeeId, validTo])
}

model EmployeeQualification {
  id        Int @id @default(autoincrement())
  companyId Int
  employeeId Int

  qualificationType String @default("OTHER") // DRIVING_LICENSE | MACHINE | CERTIFICATION | TRAINING | OTHER
  title             String
  issuer            String?
  certificateNumber String?
  qualificationCodes String?
  validFrom         DateTime?
  validUntil        DateTime?
  notes             String?

  createdById Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy User? @relation("EmployeeQualificationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, employeeId])
  @@index([employeeId, validUntil])
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiUsage {
  id                Int      @id @default(autoincrement())
  companyId         Int?
  userId            Int?
  receiptId         Int?
  action            String
  model             String
  inputTokens       Int      @default(0)
  cachedInputTokens Int      @default(0)
  outputTokens      Int      @default(0)
  totalTokens       Int      @default(0)
  costUsd           Float    @default(0)
  costIsk           Float    @default(0)
  usdIskRate        Float    @default(0)
  durationMs        Int?
  success           Boolean  @default(true)
  errorMessage      String?
  createdAt         DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([createdAt])
}

model CompanyModule {
  id        Int      @id @default(autoincrement())
  moduleId  String
  enabled   Boolean  @default(true)
  companyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleId])
  @@index([companyId])
}

model VoucherNumberReservation {
  id            Int      @id @default(autoincrement())
  companyId     Int
  voucherNumber Int
  sourceType    String
  sourceId      Int
  createdAt     DateTime @default(now())

  @@unique([companyId, voucherNumber])
  @@index([companyId])
}

model ImportBatch {
  id            Int      @id @default(autoincrement())
  companyId     Int
  bankAccountId Int?
  fileName      String
  sourceType    String   @default("CSV")
  status        String   @default("NEW")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  rows        ImportRow[]

  @@index([companyId])
  @@index([bankAccountId])
}

model ImportRow {
  id            Int       @id @default(autoincrement())
  importBatchId Int
  rowNumber     Int
  voucherNumber Int?
  date          DateTime?
  account       String?
  text          String?
  debit         Float     @default(0)
  credit        Float     @default(0)
  status        String    @default("NEW")
  errorMessage  String?
  rawData       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([importBatchId, rowNumber])
}

model UsageEvent {
  id           Int      @id @default(autoincrement())
  companyId    Int
  eventType    String
  description  String?
  quantity     Float    @default(1)
  unitCostIsk  Float    @default(0)
  totalCostIsk Float    @default(0)
