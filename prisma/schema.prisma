generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        Int    @id @default(autoincrement())
  name      String
  kennitala String @unique
  address   String
  phone     String
  email     String
  contact   String

  nextVoucherNumber Int       @default(1)
  receiptEntryMode  String    @default("AI")
  isActive          Boolean   @default(true)
  closedAt          DateTime?

  // VSK – stofngrunnur
  vatNumber           String?
  vatRegistered       Boolean?
  vatRegistrationDate DateTime?
  vatSettlementType   String?
  vatDataSource       String?
  vatDataUpdatedAt    DateTime?
  vatConfirmedAt      DateTime?
  vatConfirmedBy      String?

  // RSK / starfsemi
  rskRegisteredActivities String?
  activeActivities        String?
  rskCertificatePath      String?
  rskDataUpdatedAt        DateTime?
  activitiesConfirmedAt   DateTime?
  activitiesConfirmedBy   String?

  // Tengingar
  accounts     Account[]
  aiUsage      AiUsage[]
  auditEvents  AuditEvent[]
  modules      CompanyModule[]
  imports      ImportBatch[]
  receipts     Receipt[]
  usageEvents  UsageEvent[]
  users        UserCompany[]
  workLogs     WorkLog[]
  workOrders   WorkOrder[]
  bankAccounts BankAccount[]
  vatPeriods   VatPeriod[]
}

model Customer {
  id        Int    @id @default(autoincrement())
  name      String
  kennitala String @unique
  email     String
  phone     String
  address   String
}

model Receipt {
  id                     Int       @id @default(autoincrement())
  date                   DateTime?
  description            String
  amount                 Float
  fileName               String?
  filePath               String?
  fileHash               String?
  status                 String    @default("NEW")
  receiptNumber          String?
  voucherNumber          Int?
  merchantName           String?
  merchantKennitala      String?
  ocrText                String?
  ocrConfidence          Float?
  ocrStatus              String?
  aiDate                 DateTime?
  aiAmount               Float?
  aiApprovedAt           DateTime?
  documentCount          Int?
  suggestedDebitAccount  String?
  suggestedCreditAccount String?
  suggestedBookingText   String?
  companyId              Int
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  storagePath            String?

  aiBookingEntries    AiBookingEntry[]
  aiDetectedDocuments AiDetectedDocument[]
  company             Company              @relation(fields: [companyId], references: [id])
  entries             ReceiptEntry[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, voucherNumber])
}

model ReceiptEntry {
  id        Int     @id @default(autoincrement())
  account   String
  text      String
  debit     Float   @default(0)
  credit    Float   @default(0)
  receiptId Int
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model AiBookingEntry {
  id        Int     @id @default(autoincrement())
  account   String
  text      String
  debit     Float   @default(0)
  credit    Float   @default(0)
  receiptId Int
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model AiDetectedDocument {
  id                     Int       @id @default(autoincrement())
  merchantName           String?
  date                   DateTime?
  receiptNumber          String?
  totalAmount            Float?
  summary                String
  receiptId              Int
  approvedAt             DateTime?
  voucherNumber          Int?
  reviewedAt             DateTime?
  pageNumber             Int?
  duplicateMarkedAt      DateTime?
  duplicateOfDocumentId  Int?
  duplicateVoucherNumber Int?
  merchantKennitala      String?

  receipt        Receipt                   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  bookingEntries AiDetectedDocumentEntry[]

  @@index([receiptId])
  @@index([voucherNumber])
}

model AiDetectedDocumentEntry {
  id         Int                @id @default(autoincrement())
  account    String
  text       String
  debit      Float              @default(0)
  credit     Float              @default(0)
  documentId Int
  document   AiDetectedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Account {
  id        Int     @id @default(autoincrement())
  number    String
  name      String
  type      String
  isActive  Boolean @default(true)
  entryRole String  @default("GENERAL")

  // VSK-meðferð
  vatRate                 Int?
  vatAccount              String?
  vatCode                 String?
  vatTreatment            String?
  vatDeductiblePercent    Int?
  vatRequiresConfirmation Boolean @default(false)

  companyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, number])
  @@index([companyId, isActive])
}

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String?
  mustChangePassword Boolean  @default(false)
  role               String   @default("CLIENT")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions            Session[]
  companies           UserCompany[]
  workLogs            WorkLog[]
  createdWorkOrders   WorkOrder[]
  vatSubmissions      VatSubmission[]
  passwordResetTokens PasswordResetToken[]
  auditEvents         AuditEvent[]
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserCompany {
  id         Int     @id @default(autoincrement())
  userId     Int
  companyId  Int
  isActive   Boolean @default(true)
  accessRole String  @default("MANAGER")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiUsage {
  id                Int      @id @default(autoincrement())
  companyId         Int?
  userId            Int?
  receiptId         Int?
  action            String
  model             String
  inputTokens       Int      @default(0)
  cachedInputTokens Int      @default(0)
  outputTokens      Int      @default(0)
  totalTokens       Int      @default(0)
  costUsd           Float    @default(0)
  costIsk           Float    @default(0)
  usdIskRate        Float    @default(0)
  durationMs        Int?
  success           Boolean  @default(true)
  errorMessage      String?
  createdAt         DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([createdAt])
}

model CompanyModule {
  id        Int      @id @default(autoincrement())
  moduleId  String
  enabled   Boolean  @default(true)
  companyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleId])
  @@index([companyId])
}

model VoucherNumberReservation {
  id            Int      @id @default(autoincrement())
  companyId     Int
  voucherNumber Int
  sourceType    String
  sourceId      Int
  createdAt     DateTime @default(now())

  @@unique([companyId, voucherNumber])
  @@index([companyId])
}

model ImportBatch {
  id            Int      @id @default(autoincrement())
  companyId     Int
  bankAccountId Int?
  fileName      String
  sourceType    String   @default("CSV")
  status        String   @default("NEW")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  rows        ImportRow[]

  @@index([companyId])
  @@index([bankAccountId])
}

model ImportRow {
  id            Int       @id @default(autoincrement())
  importBatchId Int
  rowNumber     Int
  voucherNumber Int?
  date          DateTime?
  account       String?
  text          String?
  debit         Float     @default(0)
  credit        Float     @default(0)
  status        String    @default("NEW")
  errorMessage  String?
  rawData       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([importBatchId, rowNumber])
}

model UsageEvent {
  id           Int      @id @default(autoincrement())
  companyId    Int
  eventType    String
  description  String?
  quantity     Float    @default(1)
  unitCostIsk  Float    @default(0)
  totalCostIsk Float    @default(0)
  metadata     String?
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdAt])
  @@index([eventType])
}

model WorkOrder {
  id          Int       @id @default(autoincrement())
  companyId   Int
  createdById Int?
  title       String
  description String?
  address     String?
  priority    String    @default("NORMAL")
  status      String    @default("NEW")
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  workLogs  WorkLog[]
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id])

  @@index([companyId])
  @@index([status])
  @@index([createdById])
}

model WorkLog {
  id              Int       @id @default(autoincrement())
  companyId       Int
  workOrderId     Int
  userId          Int?
  workDate        DateTime
  startedAt       DateTime?
  endedAt         DateTime?
  breakMinutes    Int       @default(0)
  durationMinutes Int?
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([workOrderId])
  @@index([userId])
  @@index([workDate])
}

model BankAccount {
  id            Int      @id @default(autoincrement())
  companyId     Int
  name          String
  bankName      String
  accountNumber String?
  iban          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions  BankTransaction[]
  importBatches ImportBatch[]

  @@index([companyId])
}

model BankTransaction {
  id            Int      @id @default(autoincrement())
  bankAccountId Int
  date          DateTime
  text          String
  amount        Decimal
  reference     String?
  fingerprint   String?
  status        String   @default("UNRECONCILED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([bankAccountId, fingerprint])
  @@index([bankAccountId, date])
  @@index([bankAccountId, status])
}

model VatPeriod {
  id        Int @id @default(autoincrement())
  companyId Int
  year      Int
  period    Int

  // Tímabil
  periodType  String?
  periodStart DateTime?
  periodEnd   DateTime?

  // Staða tímabils
  status  String    @default("OPEN")
  dueDate DateTime?

  // Uppruni / staðfesting
  dataSource  String?
  confirmedAt DateTime?
  confirmedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submissions VatSubmission[]

  @@unique([companyId, year, period])
  @@index([companyId, year, period])
  @@index([companyId, status])
  @@index([companyId, dueDate])
}

model VatSubmission {
  id             Int    @id @default(autoincrement())
  vatPeriodId    Int
  version        Int    @default(1)
  submissionType String @default("ORIGINAL")
  status         String @default("DRAFT")

  // VSK-skýrsla A–H
  a Float @default(0)
  b Float @default(0)
  c Float @default(0)
  d Float @default(0)
  e Float @default(0)
  f Float @default(0)
  g Float @default(0)
  h Float @default(0)

  // Útreikningur / leiðrétting
  calculationSource String?
  calculatedAt      DateTime?
  correctionReason  String?

  // Skil og rekjanleiki
  createdById    Int?
  submittedAt    DateTime?
  rskReference   String?
  rskReceiptPath String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vatPeriod VatPeriod @relation(fields: [vatPeriodId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([vatPeriodId, version])
  @@index([vatPeriodId])
  @@index([vatPeriodId, status])
  @@index([submittedAt])
}

// Sameiginlegur rekjanleiki GLÖGGT.
//
// Markmiðið er að varðveita atburðasögu án þess að þurfa
// sérstakt audit-model fyrir Fylgiskjöl, VSK, Banka, Verk o.s.frv.
//
// entityType + entityId segja hvaða hlut atburðurinn varðar.
// Dæmi:
// RECEIPT / 42
// VAT_SUBMISSION / 8
// BANK_TRANSACTION / 120
//
// parentEntityType + parentEntityId má nota til að tengja atburð
// við stærra samhengi, t.d. bókunarlínu við fylgiskjal.
model AuditEvent {
  id        Int  @id @default(autoincrement())
  companyId Int
  userId    Int?

  entityType String
  entityId   Int
  action     String

  parentEntityType String?
  parentEntityId   Int?

  source      String  @default("SYSTEM")
  description String?

  // JSON texti varðveitir stöðu fyrir/eftir þegar þess þarf.
  // Við geymum ekki slíkt nema atburðurinn krefjist þess.
  beforeData Json?
afterData  Json?
metadata   Json?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([entityType, entityId])
  @@index([parentEntityType, parentEntityId])
  @@index([userId])
  @@index([action])
}
