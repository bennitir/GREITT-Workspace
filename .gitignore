# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated prisma client
/app/generated/prisma

# local databases
*.db
dev.db.TEST

# uploaded customer documents
/public/uploads/

# generated developer packages
/_dev-package/
/GLOGGT-dev-package.zip

# local ZIP backups
/*.zip

# temporary folders
/temp-baseline-check/
/temp-yesterday/

# local page backups
*.backup-*.tsx

# old SQLite migration archives
/prisma/migrations-sqlite-backup/
/prisma/migrations-sqlite-history/
# local diagnostic and migration helper files
/check-*.ts
/scripts/check-*.ts
/CHANGES-*.txt

/prisma/*.sql
/prisma/schema-*.prisma